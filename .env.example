# ---------------------------------------------------------------------------
# Bu değişkenler ZORUNLU DEĞİL.
#
# Gerçek değerler src/lib/analytics.ts içinde varsayılan olarak duruyor
# (gizli bilgi değiller — ikisi de sayfa kaynağında herkese görünür).
# Buradaki değişkenler yalnızca farklı bir mülk kullanmak istediğinizde,
# örneğin test ortamı için, varsayılanları ezmeye yarar.
#
# Yerelde: bu dosyayı .env.local olarak kopyalayıp doldurun
# Vercel'de: Settings → Environment Variables
# ---------------------------------------------------------------------------

# GA4 ölçüm kimliği — analytics.google.com → Yönetici → Veri akışları
NEXT_PUBLIC_GA_ID=

# Search Console doğrulama token'ı (HTML etiketi yöntemindeki content değeri)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
